#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        for (int i = 0; i < s.length(); i += 2) {
            cout << s[i];
        }

        if (s.length() % 2 == 0) {
            cout << s.back();
        }

        cout << '\n';
    }

    return 0;
}
