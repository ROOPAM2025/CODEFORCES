#include <bits/stdc++.h>
using namespace std;

int main() {
    string s;
    cin >> s;

    int lower = 0, upper = 0;

    for (char c : s) {
        if (c >= 'a' && c <= 'z')
            lower++;
        else
            upper++;
    }

    if (lower > upper) {
        for (char &c : s) {
            if (c >= 'A' && c <= 'Z')
                c += 32;
        }
    } 
    else {
        for (char &c : s) {
            if (c >= 'a' && c <= 'z')
                c -= 32;
        }
    }

    cout << s << '\n';

    return 0;
}
