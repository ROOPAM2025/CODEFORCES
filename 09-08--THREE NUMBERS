#include <iostream>
#include <algorithm>
using namespace std;
 
int main() {
    int t;
    cin >> t;
 
    while (t--) {
        long long a, b, c;
        cin >> a >> b >> c;
 
        long long mn = min({a, b, c});
        long long mx = max({a, b, c});
        long long mid = a + b + c - mn - mx;
 
        cout << min(mx - mn, mid) << '\n';
    }
 
    return 0;
}
